# Copy this file to .env and fill in real values before deploying.
# .env is already git-ignored — never commit real secrets.

# Resend (https://resend.com) API key used by src/pages/api/enquiry.ts
# to send contact-form submissions by email.
RESEND_API_KEY=

# Where enquiry emails are delivered to. Defaults to info@intignisindustries.com
# in code if left unset, but set it explicitly in production.
ENQUIRY_TO_EMAIL=info@intignisindustries.com

# The "from" address Resend sends as. Must be on a domain you've verified
# with Resend (see their dashboard) — you cannot send as a domain you don't own.
ENQUIRY_FROM_EMAIL=enquiries@intignisworld.com
