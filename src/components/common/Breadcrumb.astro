---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [{ label: "Home", href: "/" }, ...items].map((item, i, arr) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.label,
    ...(item.href || i < arr.length - 1 ? { item: new URL(item.href ?? "#", Astro.site) } : {}),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<nav aria-label="Breadcrumb" class="py-4 text-sm text-brand-ink/60">
  <ol class="flex flex-wrap items-center gap-2">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {item.href ? (
          <a href={item.href} class="hover:text-brand-orange">{item.label}</a>
        ) : (
          <span aria-current="page" class="text-brand-ink">{item.label}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>
