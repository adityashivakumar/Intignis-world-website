---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  tone?: "light" | "dark";
}
const { eyebrow, title, description, align = "left", tone = "light" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center"]}>
  {eyebrow && (
    <p class:list={["text-sm font-semibold tracking-wide", tone === "dark" ? "text-brand-orange-light" : "text-brand-orange"]}>
      {eyebrow}
    </p>
  )}
  <h2 class:list={["mt-2 text-3xl sm:text-4xl font-bold leading-tight", tone === "dark" ? "text-white" : "text-brand-ink"]}>
    {title}
  </h2>
  {description && (
    <p class:list={["mt-4 text-base sm:text-lg leading-relaxed", tone === "dark" ? "text-white/70" : "text-brand-ink/70"]}>
      {description}
    </p>
  )}
</div>
