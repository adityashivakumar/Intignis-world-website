---
import type { Brand } from "../../types/brand";

interface Props {
  brand: Brand;
  productCount?: number;
}
const { brand, productCount } = Astro.props;
---

<a
  href={`/human-consumables/${brand.slug}`}
  class="group flex flex-col overflow-hidden rounded-sm border border-black/10 bg-white transition-shadow hover:shadow-lg"
>
  <div class="aspect-[4/3] w-full overflow-hidden bg-hc-beige/60">
    <img src={brand.cardImage} alt={brand.name} loading="lazy" decoding="async" width="800" height="600" class="h-full w-full object-cover transition-transform group-hover:scale-[1.03]" />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg font-display font-bold text-brand-ink">{brand.name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-brand-ink/65">{brand.tagline}</p>
    {typeof productCount === "number" && (
      <p class="mt-3 text-xs font-medium text-hc-green">{productCount} products</p>
    )}
    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-hc-green group-hover:text-brand-orange">
      Explore {brand.name}
      <span aria-hidden="true">›</span>
    </span>
  </div>
</a>
