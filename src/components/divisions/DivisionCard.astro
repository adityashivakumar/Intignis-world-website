---
import type { Division } from "../../types/division";

interface Props {
  division: Division;
  index: number;
}
const { division, index } = Astro.props;
const isConsumables = division.id === "human-consumables";
---

<a
  href={`/${division.slug}`}
  class:list={[
    "group relative flex min-h-[340px] flex-col justify-end overflow-hidden rounded-sm p-8 sm:p-10 text-white transition-transform hover:-translate-y-1",
    isConsumables ? "bg-hc-green-dark" : "bg-ind-navy",
  ]}
>
  <img
    src={division.heroImage}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover opacity-30 transition-opacity group-hover:opacity-45"
  />
  <div class="relative">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/70">
      {`Division 0${index + 1}`}
    </p>
    <h3 class="mt-3 text-2xl sm:text-3xl font-display font-bold">{division.name}</h3>
    <p class="mt-2 text-white/75">{division.tagline}</p>
    <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-orange-light">
      Explore {division.name}
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">›</span>
    </span>
  </div>
</a>
