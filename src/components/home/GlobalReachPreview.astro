---
import Container from "../common/Container.astro";
import SectionHeader from "../common/SectionHeader.astro";

const points = ["Global markets", "Export-ready products", "Reliable sourcing", "Customer-centric approach"];
---

<section class="bg-brand-navy py-20 sm:py-24 text-white">
  <Container class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-center" data-reveal>
    <div>
      <SectionHeader tone="dark" eyebrow="Global Reach" title="Indian Products for a Global Tomorrow." />
      <ul class="mt-6 grid grid-cols-2 gap-3">
        {points.map((point) => (
          <li class="rounded-sm border border-white/15 px-4 py-3 text-sm text-white/80">{point}</li>
        ))}
      </ul>
      <a href="/global-reach" class="mt-6 inline-block text-sm font-semibold text-brand-orange-light hover:text-white">
        Learn about our global reach →
      </a>
    </div>
    <div class="aspect-[4/3] w-full overflow-hidden rounded-sm bg-white/5">
      <img src="/images/global/world-map-placeholder.jpg" alt="India to global markets" loading="lazy" decoding="async" class="h-full w-full object-cover" />
    </div>
  </Container>
</section>
