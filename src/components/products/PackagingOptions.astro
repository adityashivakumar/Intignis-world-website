---
interface Props {
  packaging: string[];
}
const { packaging } = Astro.props;
---

{packaging.length > 0 ? (
  <div class="flex flex-wrap gap-3">
    {packaging.map((option) => (
      <span class="rounded-sm border border-black/10 bg-white px-4 py-2 text-sm font-medium text-brand-ink">
        {option}
      </span>
    ))}
  </div>
) : (
  <p class="text-sm text-brand-ink/50">Packaging details available on request.</p>
)}
