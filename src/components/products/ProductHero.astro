---
import type { Product } from "../../types/product";
import { getBrand } from "../../data/brands";

interface Props {
  product: Product;
}
const { product } = Astro.props;
const brand = getBrand(product.brand);
const isIndustrial = product.division === "industrial-solutions";
---

<div class="grid gap-10 py-8 lg:grid-cols-2 lg:items-center lg:py-14">
  <div class="aspect-[4/3] w-full overflow-hidden rounded-sm bg-slate-100">
    <img src={product.image} alt={product.name} loading="eager" decoding="async" width="800" height="600" class="h-full w-full object-cover" />
  </div>
  <div>
    <p class:list={["text-sm font-semibold uppercase tracking-wide", isIndustrial ? "text-ind-steel" : "text-hc-green"]}>
      {brand?.name ?? product.category}
    </p>
    <h1 class="mt-2 text-3xl sm:text-4xl font-display font-bold text-brand-ink">{product.name}</h1>
    <p class="mt-4 text-base leading-relaxed text-brand-ink/70">{product.shortDescription}</p>

    {product.status === "on-request" && (
      <p class="mt-3 inline-block rounded-sm bg-brand-orange/10 px-3 py-1 text-xs font-semibold text-brand-orange">
        Details available on request
      </p>
    )}

    <a
      href="/contact"
      class:list={[
        "mt-7 inline-flex items-center justify-center rounded-sm px-7 py-3.5 text-sm font-semibold text-white",
        isIndustrial ? "bg-ind-navy hover:bg-ind-steel" : "bg-hc-green hover:bg-hc-green-dark",
      ]}
    >
      Request Product Information
    </a>
  </div>
</div>
