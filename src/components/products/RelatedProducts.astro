---
import type { Product } from "../../types/product";
import ProductCard from "./ProductCard.astro";

interface Props {
  products: Product[];
}
const { products } = Astro.props;
---

{products.length > 0 && (
  <div>
    <h2 class="text-2xl font-display font-bold text-brand-ink">Related Products</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((product) => <ProductCard product={product} compact />)}
    </div>
  </div>
)}
