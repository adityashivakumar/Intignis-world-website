---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/common/Container.astro";
---

<BaseLayout title="Page Not Found" noIndex>
  <section class="flex min-h-[60vh] items-center py-20">
    <Container class="text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-orange">404</p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-display font-bold text-brand-ink">
        This page doesn't exist.
      </h1>
      <p class="mx-auto mt-4 max-w-md text-brand-ink/65">
        The page you're looking for may have moved. Try one of the links below, or head back home.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/" class="inline-flex items-center justify-center rounded-sm bg-brand-navy px-6 py-3 text-sm font-semibold text-white hover:bg-brand-orange">
          Back to Home
        </a>
        <a href="/human-consumables" class="inline-flex items-center justify-center rounded-sm border border-black/15 px-6 py-3 text-sm font-semibold text-brand-ink hover:border-brand-orange hover:text-brand-orange">
          Human Consumables
        </a>
        <a href="/industrial-solutions" class="inline-flex items-center justify-center rounded-sm border border-black/15 px-6 py-3 text-sm font-semibold text-brand-ink hover:border-brand-orange hover:text-brand-orange">
          Industrial Solutions
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
