---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/common/Container.astro";
import Breadcrumb from "../../components/common/Breadcrumb.astro";
import SectionHeader from "../../components/common/SectionHeader.astro";
import ProductCard from "../../components/products/ProductCard.astro";
import CTASection from "../../components/common/CTASection.astro";
import { getBrand } from "../../data/brands";
import { industrialProducts, fireSolTechnicalBenefits } from "../../data/industrialSolutions";

const brand = getBrand("fire-sol")!;
---

<BaseLayout title="Fire-Sol®" description={brand.description}>
  <Container>
    <Breadcrumb items={[{ label: "Industrial Solutions", href: "/industrial-solutions" }, { label: "Fire-Sol®" }]} />
  </Container>

  <section class="bg-ind-navy py-14 sm:py-16 text-white">
    <Container>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-orange-light">Industrial Brand</p>
      <h1 class="mt-2 text-4xl sm:text-5xl font-display font-bold">Fire-Sol®</h1>
      <p class="mt-3 text-lg text-white/70">{brand.tagline}</p>
    </Container>
  </section>

  <section class="py-14 sm:py-16">
    <Container class="max-w-3xl space-y-4 text-brand-ink/75 leading-relaxed">
      <p>{brand.description}</p>
      <p>{brand.sourcing}</p>
    </Container>
  </section>

  <section class="py-4 sm:py-6">
    <Container>
      <SectionHeader eyebrow="Product Collection" title="Fire-Sol® Range" />
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {industrialProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </Container>
  </section>

  <section class="bg-slate-50 py-14 sm:py-16">
    <Container>
      <SectionHeader eyebrow="Technical Benefits" title="Why Fire-Sol®" />
      <p class="mt-2 text-xs text-brand-ink/40">As published; sourced from the current Intignis Industries website.</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {fireSolTechnicalBenefits.map((benefit) => (
          <li class="flex items-start gap-2 text-sm text-brand-ink/75">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ind-steel"></span>
            {benefit}
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <CTASection headline="Talk to Our Boiler Chemistry Team" ctaLabel="Request Technical Consultation" />
</BaseLayout>
