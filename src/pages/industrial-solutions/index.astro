---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/common/Container.astro";
import SectionHeader from "../../components/common/SectionHeader.astro";
import ProductBrowser from "../../components/products/ProductBrowser";
import CTASection from "../../components/common/CTASection.astro";
import { industrialProducts, boilerTypes } from "../../data/industrialSolutions";
import { toSearchable } from "../../lib/products";

const searchable = industrialProducts.map(toSearchable);

const filterGroups = [
  {
    label: "Boiler Type",
    key: "boilerTypeCode" as const,
    options: boilerTypes.map((code) => ({ value: code, label: code })),
  },
];
---

<BaseLayout
  title="Industrial Solutions"
  description="Fire-Sol boiler chemistry and combustion optimization solutions, adapted to boiler type and fuel type."
>
  <section class="bg-ind-navy py-16 sm:py-20 text-white">
    <Container>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-orange-light">Industrial Solutions</p>
      <h1 class="mt-2 text-4xl sm:text-5xl font-display font-bold">Engineering performance for a more efficient tomorrow.</h1>
      <p class="mt-4 max-w-xl text-white/70">
        Fire-Sol® is our range of combustion and boiler chemistry solutions — adapted to boiler type, fuel type and customer requirements.
      </p>
    </Container>
  </section>

  <section class="py-14 sm:py-16">
    <Container>
      <SectionHeader
        eyebrow="Fire-Sol®"
        title="Combustion. Boiler Chemistry. Fuel Optimization. Industrial Performance."
        description="Each grade of Fire-Sol® is tailored to a boiler type and its fuel. Browse the range below, or get in touch for a custom formulation."
      />
    </Container>
  </section>

  <section class="pb-16 sm:pb-20">
    <Container>
      <ProductBrowser client:load products={searchable} filterGroups={filterGroups} basePath="/industrial-solutions/products" accent="steel" />
    </Container>
  </section>

  <CTASection headline="Need a Custom Formulation?" description="Tell us your boiler type and fuel — our engineers will recommend the right Fire-Sol grade." ctaLabel="Request Technical Consultation" />
</BaseLayout>
