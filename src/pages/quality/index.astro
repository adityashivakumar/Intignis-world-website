---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/common/Container.astro";
import SectionHeader from "../../components/common/SectionHeader.astro";
import CTASection from "../../components/common/CTASection.astro";
import { certifications } from "../../data/company";

const sections = [
  {
    title: "Quality Philosophy",
    description:
      "At Intignis, every product undergoes standard quality testing, screening, and verification processes to ensure superior quality, consistency, and safety standards.",
  },
  {
    title: "Testing & Verification",
    description:
      "Products are screened and verified before dispatch, with the aim of delivering the best quality at competitive prices while maintaining international quality standards.",
  },
  {
    title: "Quality Control",
    description:
      "Consistent processing standards are applied across production batches to reduce variance between shipments.",
  },
  {
    title: "Consistency",
    description:
      "We work with trusted suppliers across India to maintain consistent quality, purity and supply across every order.",
  },
  {
    title: "Export Readiness",
    description:
      "Packaging and documentation are prepared with international buyers in mind, supporting long-term business relationships.",
  },
];

---

<BaseLayout title="Quality" description="Our quality philosophy, testing and verification approach, and export readiness at INTIGNIS WORLD.">
  <section class="bg-brand-navy py-16 sm:py-20 text-white">
    <Container>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-orange-light">Quality</p>
      <h1 class="mt-2 text-4xl sm:text-5xl font-display font-bold">Consistency You Can Rely On.</h1>
    </Container>
  </section>

  <section class="py-16 sm:py-20">
    <Container class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {sections.map((section) => (
        <div class="rounded-sm border border-black/10 p-7">
          <h2 class="font-display text-lg font-bold text-brand-ink">{section.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-brand-ink/65">{section.description}</p>
        </div>
      ))}
    </Container>
  </section>

  <section class="bg-hc-cream py-16 sm:py-20">
    <Container>
      <SectionHeader eyebrow="Certifications" title="Recognition & Compliance" align="center" />
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        {certifications.map((cert) => (
          <div class="flex h-28 w-44 flex-col items-center justify-center gap-1 rounded-sm border border-black/10 bg-white text-center px-3">
            <p class="text-sm font-semibold text-brand-ink">{cert.name}</p>
            <p class="text-xs text-brand-ink/45">{cert.note}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-center text-xs text-brand-ink/40">
        Certificate images to be added — currently text-only pending final assets.
      </p>
    </Container>
  </section>

  <CTASection headline="Have Quality or Compliance Questions?" />
</BaseLayout>
